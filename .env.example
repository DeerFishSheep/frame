# Server only. Never add a NEXT_PUBLIC_ prefix.
# Set either a v3 API key or a Read Access Token. Token takes priority if both are set.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
# Optional: defaults to 1800 seconds.
TMDB_CACHE_SECONDS=1800

# Optional Pansou server URL, for example http://pansou:80.
# Keep this server-side; never use a NEXT_PUBLIC_ prefix.
PANSOU_BASE_URL=
