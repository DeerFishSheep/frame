# filmsou.sh reads this file. Copy to .env and edit; the script fills PANSOU_BASE_URL for you.
# Never commit the real .env.

# --- versions (what "update" and "rollback" change) ---
FRAME_IMAGE=ghcr.io/deerfishsheep/frame
FRAME_VERSION=latest
PANSOU_IMAGE=ghcr.io/fish2018/pansou-web
PANSOU_VERSION=latest

# --- ports (all bound to 127.0.0.1; put a reverse proxy in front) ---
FRAME_PORT=3000
PANSOU_PORT=23456
SOEASY_PORT=8080

# --- frame secrets ---
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
TMDB_CACHE_SECONDS=1800

# --- how frame reaches Pansou ---
# Co-deployed (same compose network): http://pansou:80
# Frame only, Pansou on the host:     http://172.17.0.1:23456
PANSOU_BASE_URL=http://pansou:80

# --- pansou tuning (empty = Pansou image default) ---
PANSOU_ENABLED_PLUGINS=
PANSOU_CHANNELS=
PANSOU_CONCURRENCY=60
PANSOU_MAX_WORKERS=60
PANSOU_CACHE_SIZE=500
PANSOU_TIMEOUT=6
